meta {
  name: G01 Invitado no puede reservar
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/group-buying/{{lotId}}/reserve
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{$randomUUID}}
}

body:json {
  {"quantity":10}
}

assert {
  res.status: eq 403
  res.body.code: eq BUYER_REQUIRED
}
