meta {
  name: G02 Sin Idempotency-Key es 400
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/group-buying/{{lotId}}/reserve
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{tokenMinorista}}
}

body:json {
  {"quantity":10}
}

assert {
  res.status: eq 400
  res.body.code: eq INVALID_IDEMPOTENCY_KEY
}
