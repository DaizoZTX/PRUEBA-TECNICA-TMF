meta {
  name: Q02 Minorista 60 TOR = 720 x 60 = 43200 centavos
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/quotes/calculate
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{tokenMinorista}}
}

body:json {
  {"items":[{"productId":"{{productoTor}}","quantity":60}]}
}

assert {
  res.status: eq 200
  res.body.totalCents: eq 43200
  res.body.lines[0].unitPriceCents: eq 720
}
