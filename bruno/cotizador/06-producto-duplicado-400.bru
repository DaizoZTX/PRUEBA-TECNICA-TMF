meta {
  name: Q12 Mismo producto dos veces es rechazado
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/quotes/calculate
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{tokenMinorista}}
}

body:json {
  {"items":[{"productId":"{{productoTor}}","quantity":10},{"productId":"{{productoTor}}","quantity":10}]}
}

assert {
  res.status: eq 400
  res.body.code: eq DUPLICATE_PRODUCT
}
