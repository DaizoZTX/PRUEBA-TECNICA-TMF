meta {
  name: Q20 Campo no permitido (price) es rechazado
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/quotes/calculate
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{tokenMinorista}}
}

body:json {
  {"items":[{"productId":"{{productoTor}}","quantity":10,"price":1}]}
}

assert {
  res.status: eq 400
}
